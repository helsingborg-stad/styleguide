{
	"title": "JSON schema for Helsingborg Styleguide Design Tokens",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"name": {
			"type": "string"
		},
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$"
		},
		"categories": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/category"
			}
		}
	},
	"required": ["name", "version", "categories"],
	"additionalProperties": false,
	"$defs": {
		"validToken": {
			"description": "A valid design token name. Corresponds to a CSS custom property in design-tokens.json with the leading '--' stripped.",
			"type": "string",
			"enum": [
				"base",
				"base-font-size",
				"border-radius",
				"border-width",
				"corner-shape",
				"font-family-base",
				"font-family-heading",
				"font-family-code",
				"font-size-scale-ratio",
				"font-size-80",
				"font-size-90",
				"font-size-100",
				"font-size-200",
				"font-size-300",
				"font-size-400",
				"font-size-500",
				"font-size-600",
				"font-size-700",
				"font-size-800",
				"font-size-900",
				"font-weight-normal",
				"font-weight-medium",
				"font-weight-bold",
				"font-weight-heading",
				"line-height-base",
				"line-height-heading",
				"letter-spacing-base",
				"letter-spacing-heading",
				"space",
				"outer-space",
				"shadow-color",
				"shadow-amount",
				"color--border-mix-amount",
				"color--alt-mix-amount",
				"color--primary",
				"color--primary-contrast",
				"color--primary-border",
				"color--primary-alt",
				"color--secondary",
				"color--secondary-contrast",
				"color--secondary-border",
				"color--secondary-alt",
				"color--palette-1",
				"color--palette-1-contrast",
				"color--palette-1-border",
				"color--palette-1-alt",
				"color--palette-2",
				"color--palette-2-contrast",
				"color--palette-2-border",
				"color--palette-2-alt",
				"color--palette-3",
				"color--palette-3-contrast",
				"color--palette-3-border",
				"color--palette-3-alt",
				"color--palette-4",
				"color--palette-4-contrast",
				"color--palette-4-border",
				"color--palette-4-alt",
				"color--palette-5",
				"color--palette-5-contrast",
				"color--palette-5-border",
				"color--palette-5-alt",
				"color--palette-6",
				"color--palette-6-contrast",
				"color--palette-6-border",
				"color--palette-6-alt",
				"color--palette-7",
				"color--palette-7-contrast",
				"color--palette-7-border",
				"color--palette-7-alt",
				"color--palette-8",
				"color--palette-8-contrast",
				"color--palette-8-border",
				"color--palette-8-alt",
				"color--palette-9",
				"color--palette-9-contrast",
				"color--palette-9-border",
				"color--palette-9-alt",
				"color--palette-10",
				"color--palette-10-contrast",
				"color--palette-10-border",
				"color--palette-10-alt",
				"color--background",
				"color--background-contrast",
				"color--background-contrast-muted",
				"color--background-border",
				"color--background-alt",
				"color--surface",
				"color--surface-contrast",
				"color--surface-contrast-muted",
				"color--surface-border",
				"color--surface-alt",
				"color--focus",
				"color--alpha",
				"color--alpha-contrast",
				"color--alpha-border",
				"color--success",
				"color--success-contrast",
				"color--success-border",
				"color--warning",
				"color--warning-contrast",
				"color--warning-border",
				"color--danger",
				"color--danger-contrast",
				"color--danger-border",
				"color--info",
				"color--info-contrast",
				"color--info-border"
			]
		},
		"category": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]*$"
				},
				"label": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"settings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/setting"
					}
				}
			},
			"required": ["id", "label", "settings"],
			"additionalProperties": false
		},
		"setting": {
			"type": "object",
			"properties": {
				"variable": {
					"description": "CSS custom property name. Must start with '--' followed by a lowercase letter.",
					"type": "string",
					"pattern": "^--[a-z][a-z0-9-]*$"
				},
				"label": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"type": {
					"type": "string",
					"enum": ["range", "select", "color", "rgba", "font"]
				},
				"default": {},
				"fontSizeScaleStep": {
					"description": "Generates the default value from --base-font-size and --font-size-scale-ratio using this scale step.",
					"type": "number"
				},
				"unit": {
					"type": "string"
				},
				"locked": {
					"type": "boolean"
				},
				"min": {
					"type": "number"
				},
				"max": {
					"type": "number"
				},
				"step": {
					"type": "number"
				},
				"options": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/option"
					}
				},
				"contrast": {
					"description": "One or more companion CSS variable names for contrast colors.",
					"oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
				}
			},
			"required": ["variable", "label", "type"],
			"oneOf": [{ "required": ["default"] }, { "required": ["fontSizeScaleStep"] }],
			"additionalProperties": false
		},
		"option": {
			"type": "object",
			"properties": {
				"value": {
					"type": "string"
				},
				"label": {
					"type": "string"
				}
			},
			"required": ["value", "label"],
			"additionalProperties": false
		}
	}
}
